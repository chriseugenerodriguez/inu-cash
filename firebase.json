{
  "hosting": {
    "public": "app/dist/website",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/trade/**",
        "destination": "/trade/index.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "redirects": [
      {
        "source": "/swap",
        "destination": "/trade/",
        "type": 301
      },
      {
        "source": "/swap/**",
        "destination": "/trade/",
        "type": 301
      },
      {
        "source": "/exchange",
        "destination": "/trade/#/pool",
        "type": 301
      },
      {
        "source": "/exchange/**",
        "destination": "/trade/#/pool",
        "type": 301
      }
    ],
    "trailingSlash": true
  }
}
